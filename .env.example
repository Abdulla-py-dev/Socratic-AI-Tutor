# Socratic AI Tutor - Environment Configuration
# Copy this file to .env and fill in the values

# Database (SQLite default, override for PostgreSQL etc.)
DATABASE_URL=sqlite:///./socratic_tutor.db

# JWT Secret Key - MUST be set in production!
# Generate a secure random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-in-production

# Token expiration (minutes)
# ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days (default in code)

# Ollama configuration (local AI model)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b